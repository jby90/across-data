# 复制为 .env 后填写。真实密钥只放环境变量或 .env(已被 .gitignore 忽略),不要提交。
CYSH_ENV=dev
CYSH_DATABASE_URL=postgresql+asyncpg://cyshuhe:change-me@localhost:5432/cyshuhe
# 至少 32 字符的随机串,例如: python -c "import secrets;print(secrets.token_urlsafe(48))"
CYSH_JWT_SECRET=
CYSH_JWT_TTL_MINUTES=60
# 采集:仅开发机在代理 fake-IP 模式下才需要放行,例如 ["198.18.0.0/15"];生产保持为空
CYSH_CRAWL_ALLOW_RESOLVED_CIDRS=[]
CYSH_ARCHIVE_DIR=./data/archive
CYSH_CORS_ORIGINS=["http://localhost:5173","http://localhost:5174"]

# 数据库容器口令(docker compose 使用)
POSTGRES_PASSWORD=change-me
